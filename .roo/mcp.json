{
	"mcpServers": {
		"playwright-firefox": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest",
				"--browser",
				"firefox",
				"--vision"
			]
		},
		"playwright-chromium": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest",
				"--browser",
				"chromium",
				"--vision"
			],
			"disabled": false,
			"alwaysAllow": [
				"browser_navigate",
				"browser_take_screenshot",
				"browser_evaluate",
				"browser_run_code"
			]
		}
	}
}